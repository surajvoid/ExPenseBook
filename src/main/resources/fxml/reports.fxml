<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensebook.controller.ReportController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="18.0" style="-fx-padding: 4px;">

        <!-- Header & Action Bar -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card">
            <VBox spacing="2.0">
                <Label text="Financial Statements &amp; Reports" styleClass="text-h2"/>
                <Label text="Generate printable PDF statements or export detailed transaction spreadsheets" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10.0" alignment="CENTER">
                <ComboBox fx:id="reportTypeCombo" prefWidth="180.0" styleClass="combo-box"/>
                <ComboBox fx:id="monthCombo" prefWidth="130.0" styleClass="combo-box"/>
                <ComboBox fx:id="yearCombo" prefWidth="95.0" styleClass="combo-box"/>
                <Button fx:id="btnGeneratePDF" text="📄 Generate PDF" onAction="#handleGeneratePDF" styleClass="btn-primary"/>
                <Button fx:id="btnExportCSV" text="📊 Export CSV" onAction="#handleExportCSV" styleClass="btn-secondary"/>
            </HBox>
        </HBox>

        <!-- Statement Document Preview Container -->
        <VBox alignment="CENTER" style="-fx-padding: 10 0 20 0;">
            <VBox spacing="20.0" maxWidth="720.0" styleClass="card" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2DBD0; -fx-padding: 36px;">

                <!-- Document Header Banner -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: #E6F3EE; -fx-background-radius: 12px; -fx-padding: 16 20 16 20;">
                    <VBox spacing="2.0">
                        <Label text="ExPense Book" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                        <Label text="Track • Analyse • Control | Official Financial Statement" style="-fx-font-size: 11px; -fx-text-fill: #397A5E; -fx-font-weight: bold;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="previewPeriodTitle" text="August 2026" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                        <Label text="Statement Period" styleClass="text-muted"/>
                    </VBox>
                </HBox>

                <!-- Financial Highlights Summary -->
                <VBox spacing="12.0" style="-fx-padding: 10 0 10 0;">
                    <Label text="Statement Summary" styleClass="text-h3"/>
                    <Separator/>

                    <GridPane hgap="20.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="35.0"/>
                            <ColumnConstraints percentWidth="65.0"/>
                        </columnConstraints>

                        <!-- Total Expenses -->
                        <Label text="Total Expenses:" styleClass="text-stat-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="previewTotalExpenses" text="₹8,450" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #26332F;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <!-- Top Category -->
                        <Label text="Top Category:" styleClass="text-stat-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="previewTopCategory" text="Food (₹2,450)" style="-fx-font-weight: bold; -fx-text-fill: #26332F;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <!-- Top Payment Mode -->
                        <Label text="Top Payment Mode:" styleClass="text-stat-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="previewTopPayment" text="UPI (₹5,200)" style="-fx-font-weight: bold; -fx-text-fill: #26332F;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <!-- Daily Average -->
                        <Label text="Daily Average:" styleClass="text-stat-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="previewDailyAverage" text="₹444 / day" style="-fx-font-weight: bold; -fx-text-fill: #26332F;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <!-- Previous Month Comparison -->
                        <Label text="Previous Month:" styleClass="text-stat-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
                            <Label fx:id="previewPreviousMonth" text="₹9,800" style="-fx-font-weight: bold; -fx-text-fill: #71807A;"/>
                            <Label text="→ Current:" styleClass="text-muted"/>
                            <Label fx:id="previewCurrentMonth" text="₹8,450" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                            <Label fx:id="previewChangePercent" text="↓ 13.7%" styleClass="badge, badge-sage"/>
                        </HBox>
                    </GridPane>
                </VBox>

                <!-- Optional Budget Summary Section -->
                <VBox fx:id="budgetPreviewBox" spacing="10.0" style="-fx-background-color: #F8F6F0; -fx-background-radius: 12px; -fx-padding: 16px;">
                    <Label text="Budget Performance" styleClass="text-h3"/>
                    <HBox spacing="20.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="ALLOCATED BUDGET" styleClass="text-stat-label"/>
                            <Label fx:id="previewBudgetAllocated" text="₹15,000" styleClass="text-stat-number"/>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="REMAINING UNSPENT" styleClass="text-stat-label"/>
                            <Label fx:id="previewBudgetRemaining" text="₹6,550" styleClass="text-stat-number"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Footer note -->
                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="ExPense Book Personal Accounting System" styleClass="text-muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Ready to export as official PDF" styleClass="badge, badge-blue"/>
                </HBox>

            </VBox>
        </VBox>

    </VBox>
</ScrollPane>
