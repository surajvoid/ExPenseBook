<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensebook.controller.RecurringController"
      spacing="18.0" style="-fx-padding: 4px;">

    <!-- Header -->
    <VBox spacing="2.0" styleClass="card">
        <Label text="Recurring Expenses &amp; Subscriptions" styleClass="text-h2"/>
        <Label text="Automate repeating bills like Netflix, Wi-Fi, Rent, and Gym with one-click expense logging." styleClass="text-muted"/>
    </VBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <!-- Add Recurring Form -->
        <VBox spacing="14.0" styleClass="card" prefWidth="380.0" minWidth="340.0">
            <Label text="Add Recurring Expense" styleClass="text-h3"/>
            <Separator/>

            <VBox spacing="12.0">
                <VBox spacing="6.0">
                    <Label text="Title / Subscription Name" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                    <TextField fx:id="titleField" promptText="e.g. Netflix, Apartment Rent, Wi-Fi" styleClass="text-input"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Amount (â‚¹)" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                    <TextField fx:id="amountField" promptText="0.00" styleClass="text-input"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Category" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                    <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="combo-box"/>
                </VBox>

                <HBox spacing="10.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Frequency" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                        <ComboBox fx:id="frequencyCombo" maxWidth="Infinity" styleClass="combo-box"/>
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Payment Mode" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                        <ComboBox fx:id="paymentModeCombo" maxWidth="Infinity" styleClass="combo-box"/>
                    </VBox>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Next Due Date" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                    <DatePicker fx:id="nextDatePicker" maxWidth="Infinity"/>
                </VBox>

                <Button fx:id="btnAddRecurring" text="+ Save Recurring Bill" onAction="#handleAddRecurring"
                        styleClass="btn-primary" maxWidth="Infinity" prefHeight="40.0"/>
            </VBox>
        </VBox>

        <!-- Recurring List Table -->
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Active Recurring Expenses" styleClass="text-h3"/>
            <Separator/>

            <TableView fx:id="recurringTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTitle" text="Subscription / Bill" prefWidth="200.0"/>
                    <TableColumn fx:id="colFrequency" text="Frequency" prefWidth="110.0"/>
                    <TableColumn fx:id="colNextDue" text="Next Due Date" prefWidth="150.0"/>
                    <TableColumn fx:id="colAmount" text="Amount" prefWidth="120.0"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="170.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>

</VBox>

