<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensebook.controller.AdminController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="18.0" style="-fx-padding: 4px;">

        <!-- Header -->
        <VBox spacing="2.0" styleClass="card">
            <Label text="System Administration &amp; Governance" styleClass="text-h2"/>
            <Label text="Monitor application health, manage registered users, and inspect global taxonomies" styleClass="text-muted"/>
        </VBox>

        <!-- System Stats Cards -->
        <HBox spacing="16.0">
            <VBox spacing="4.0" styleClass="card, card-highlight-blue" HBox.hgrow="ALWAYS">
                <Label text="TOTAL REGISTERED USERS" styleClass="text-stat-label"/>
                <Label fx:id="totalUsersLabel" text="0" styleClass="text-stat-number-large"/>
            </VBox>
            <VBox spacing="4.0" styleClass="card, card-highlight-sage" HBox.hgrow="ALWAYS">
                <Label text="ACTIVE ACCOUNTS" styleClass="text-stat-label"/>
                <Label fx:id="activeUsersLabel" text="0" styleClass="text-stat-number-large"/>
            </VBox>
            <VBox spacing="4.0" styleClass="card, card-highlight-peach" HBox.hgrow="ALWAYS">
                <Label text="SYSTEM CATEGORIES" styleClass="text-stat-label"/>
                <Label fx:id="systemCategoriesCountLabel" text="0" styleClass="text-stat-number-large"/>
            </VBox>
            <VBox spacing="4.0" styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="DATABASE ENGINE" styleClass="text-stat-label"/>
                <Label fx:id="dbEngineLabel" text="MySQL 8.0" styleClass="text-stat-number"/>
            </VBox>
        </HBox>

        <!-- Privacy Assurance Banner -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="alert-banner">
            <Label text="🔒" style="-fx-font-size: 16px;"/>
            <VBox spacing="1.0">
                <Label text="Data Privacy &amp; Role-Based Isolation Active" style="-fx-font-weight: bold; -fx-text-fill: #26332F;"/>
                <Label text="In compliance with Section 32, user financial transaction details are isolated and not accessible from this panel." styleClass="text-muted"/>
            </VBox>
        </HBox>

        <!-- User Management Table -->
        <VBox spacing="10.0" styleClass="card">
            <Label text="User Accounts Directory" styleClass="text-h3"/>
            <Separator/>

            <TableView fx:id="usersTable" prefHeight="260.0">
                <columns>
                    <TableColumn fx:id="colUserId" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="colUserName" text="Full Name" prefWidth="180.0"/>
                    <TableColumn fx:id="colUserEmail" text="Email" prefWidth="220.0"/>
                    <TableColumn fx:id="colUserRole" text="Role" prefWidth="90.0"/>
                    <TableColumn fx:id="colUserMode" text="Financial Mode" prefWidth="160.0"/>
                    <TableColumn fx:id="colUserStatus" text="Status" prefWidth="100.0"/>
                    <TableColumn fx:id="colUserActions" text="Actions" prefWidth="170.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- System Categories Table -->
        <VBox spacing="10.0" styleClass="card">
            <Label text="Global Default Taxonomies (System Categories)" styleClass="text-h3"/>
            <Separator/>

            <TableView fx:id="defaultCategoriesTable" prefHeight="220.0">
                <columns>
                    <TableColumn fx:id="colDefaultCatName" text="Category" prefWidth="240.0"/>
                    <TableColumn fx:id="colDefaultCatIcon" text="Vector Icon Identifier" prefWidth="240.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
