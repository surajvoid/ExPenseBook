<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensebook.controller.TransactionController"
      spacing="16.0" style="-fx-padding: 4px;">

    <!-- Top Filter Bar Card -->
    <VBox spacing="14.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label text="Transaction History" styleClass="text-h2"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="resultsCountLabel" text="Showing 0 transactions" styleClass="text-muted"/>
            <Label fx:id="totalFilteredAmountLabel" text="Total: ₹0" styleClass="badge, badge-sage"/>
        </HBox>

        <!-- Filters Row 1: Search & Dropdowns -->
        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="🔍 Search description or category..." prefWidth="260.0" styleClass="text-input"/>
            <ComboBox fx:id="categoryFilterCombo" prefWidth="170.0" styleClass="combo-box"/>
            <ComboBox fx:id="paymentFilterCombo" prefWidth="140.0" styleClass="combo-box"/>
            <ComboBox fx:id="dateRangeCombo" prefWidth="140.0" styleClass="combo-box"/>
            <DatePicker fx:id="startDatePicker" promptText="Start Date" prefWidth="130.0" visible="false" managed="false"/>
            <DatePicker fx:id="endDatePicker" promptText="End Date" prefWidth="130.0" visible="false" managed="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="sortByCombo" prefWidth="140.0" styleClass="combo-box"/>
            <Button text="Reset" onAction="#handleResetFilters" styleClass="btn-secondary, btn-pill-small"/>
        </HBox>
    </VBox>

    <!-- Transactions Table Card -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10.0">
        <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDate" text="Date" prefWidth="110.0"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="180.0"/>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="260.0"/>
                <TableColumn fx:id="colPaymentMode" text="Payment Mode" prefWidth="130.0"/>
                <TableColumn fx:id="colAmount" text="Amount" prefWidth="120.0"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="140.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
