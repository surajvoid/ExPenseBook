# ==============================================================================
# ExPense Book - Production & Cloud Environment Configuration
# ==============================================================================
# Copy this file to .env for local development or configure these variables in:
# Render Dashboard -> Web Service -> Environment Settings

# Environment Mode: 'production' | 'development' | 'migration'
# In 'production' mode, missing MONGODB_URI or failed ping will abort startup cleanly
# preventing silent fallback to ephemeral disk and eliminating data loss.
APP_ENV=production

# Web Server Port (Render sets this dynamically)
PORT=8080

# Authoritative MongoDB Atlas Connection URI
# Example: mongodb+srv://expense_app:SecurePassword123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=ExPenseBook
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=ExPenseBook

# Database Name on MongoDB Atlas
MONGODB_DATABASE=expensebook

# Stateless Session Token Secret (HMAC-SHA256 signature)
# Set to a secure, random string (min 32 characters)
SESSION_SECRET=ExpenseBook-Stateless-Session-Secret-Production-2026-RockSolid

# (Optional) Google Gemini API Key for AI Financial Analysis Chat
GEMINI_API_KEY=
